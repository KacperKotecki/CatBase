@{
    ViewData["Title"] = "Fact about cats";
}
<div class="page-container">

    <h1 class="page-title">Pobierz informacje na temat kotów</h1>

    <div class="stats-bar">
        <div class="stat-card">
            <span class="stat-label">Pobrane faktyw sesji</span>
            <span class="stat-value" id="counter-value">0</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Rozmiar pliku</span>
            <span class="stat-value" id="file-size-value">0 KB</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Czas odpowiedzi</span>
            <span class="stat-value" id="time-to-response-value">0 ms</span>
        </div>
            <div class="stat-card">
            <span class="stat-label">Liczba znaków</span>
            <span class="stat-value" id="char-count-value">0</span>
        </div>

    </div>

    <div class="terminal-window">
        <div class="terminal-header">
            <span class="terminal-prompt">kacper@macbook-air-kacper ~ %</span> ./fetch_cat_facts.sh
        </div>
        <div class="terminal-content" id="cat-facts-console">
            <div class="log-line">> Inicjalizacja modułu kocich faktów...</div>
            <div class="log-line">> Nawiązywanie połączenia z catfact.ninja... [OK]</div>
            <span class="blinking-cursor">_</span>
        </div>
    </div>

    <div class="btn-action-row">
        <button class="btn-cartoon" onclick="GetFact(); ClickTime()"></button>
        <span id="Click-time">Kliknij, aby pobrać fakt o kotach</span>
    </div>

    <div>
        <img id="cat-animation" src="/css/cat-chillout.gif" alt="cat" width="150" />

    </div>
</div>
<script>
let counter = 0;
let lastClickTime = null;
let inactivityTimer = null;

function GetFact() {
    fetch("/CatFacts/GetFact")
        .then(res => res.json())
        .then(data => {
            const consoleElement = document.getElementById('cat-facts-console');
            const cursorElement = document.querySelector('.blinking-cursor');

            const newLine = document.createElement('div');
            newLine.className = 'log-line';
            newLine.textContent = "> " + data.fact;

            consoleElement.insertBefore(newLine, cursorElement);

            const terminalWindow = document.querySelector('.terminal-window');
            terminalWindow.scrollTop = terminalWindow.scrollHeight;

            counter++;
            document.getElementById("counter-value").textContent = counter + " faktów pobranych";
            document.getElementById("file-size-value").textContent = data.fileSizeKb + " KB";
            document.getElementById("time-to-response-value").textContent = data.timeToResponseMs + " ms";
            document.getElementById("char-count-value").textContent = data.charCount + " znaków";
        })
        .catch(error => console.error("Błąd:", error));
}
function ClickTime() {
    const now = performance.now();
    let timeBetween = 0;
    if (lastClickTime !== null) {
        timeBetween = (now - lastClickTime).toFixed(0);
        document.getElementById("Click-time").textContent = `Czas od ostatniego kliknięcia: ${timeBetween}ms`;
    }

        if (lastClickTime === null || timeBetween > 1000) {
            setCatAnimation("/css/cat-chillout.gif");
        } else if (timeBetween > 300) {
            setCatAnimation("/css/cat walking.gif");
        } else {
            setCatAnimation("/css/cat-happy.gif");
        }

    clearTimeout(inactivityTimer);
    inactivityTimer = setTimeout(() => {
        document.getElementById("cat-animation").src = "/css/cat-chillout.gif";
        document.getElementById("Click-time").textContent = "Kliknij, aby pobrać fakt o kotach";
    }, 1500);

    lastClickTime = now;
}

function setCatAnimation(src) {
    const img = document.getElementById("cat-animation");
    if (!img.src.endsWith(src)) 
    { 
        img.src = src;
    }
}

</script>

